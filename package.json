{
  "name": "personal-page",
  "version": "1.0.0",
  "description": "My personal page for basic information and presenting my expertise in as Software Developer. Containing short bio, short work history, full CV, and projects and training pages too.",
  "main": "index.js",
  "scripts": {
    "watch:sass": "sass --watch sass/main.scss:css/main.css",
    "compile:sass": "sass sass/main.scss:css/main.compiled.css",
    "prefix:css": "postcss --use autoprefixer -b 'last 10 versions' css/main.compiled.css -o css/main.prefixed.css",
    "compress:sass": "sass css/main.prefixed.css:css/main.css --style=compressed",
    "build:css": "npm run compile:sass && npm run prefix:css && npm run compress:sass",
    "compile-critical:sass": "sass sass/critical.scss:css/critical.compiled.css",
    "prefix-critical:css": "postcss --use autoprefixer -b 'last 10 versions' css/critical.compiled.css -o css/critical.prefixed.css",
    "compress-critical:css": "sass css/critical.prefixed.css:css/critical.css --style=compressed",
    "build-critical:css": "npm run compile-critical:sass && npm run prefix-critical:css && npm run compress-critical:css"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeterKocsis/personal-page.git"
  },
  "keywords": [
    "CV",
    "Kocsis",
    "Peter",
    "work",
    "history",
    "software",
    "frontend",
    "web",
    "developer"
  ],
  "author": "Peter Kocsis",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/PeterKocsis/personal-page/issues"
  },
  "homepage": "https://github.com/PeterKocsis/personal-page#readme",
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "concat": "^1.0.3",
    "postcss-cli": "^11.0.1",
    "sass": "^1.90.0"
  }
}
